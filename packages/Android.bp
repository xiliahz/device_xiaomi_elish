android_app_import {
    name: "CameraGo",
    apk: "GCamGOPrebuilt.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    overrides: [
        "Camera2", "Snap", "Aperture",

        // remove some UNRELATED packages meanwhile
        "Dialer", "GoogleDialer", "com.google.android.dialer.support",
        "messaging", "PrebuiltBugle",
        "GoogleContacts",
        "Stk",
        "SafetyHubPrebuilt",
        "RecorderPrebuilt",
        "CalculatorGooglePrebuilt"
    ],
    product_specific: true,
}

android_app_import {
    name: "via",
    owner: "thirdparty",
    apk: "via.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    overrides: [
        "Browser2", "Chromium","CarHTMLViewer","Jelly",
    ],
    product_specific: true,
}

android_app_import {
    name: "Omni",
    owner: "AkaneFoundation",
    apk: "Omni.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: true,
    },
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    product_specific: true,
}
